/* pages/index/index.wxss */

/* 顶部主视觉 */
.page-hero {
  margin: -24rpx -24rpx 0;
  height: 375rpx;
  overflow: hidden;
  background: #0B1030;
}

.page-hero-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 首张卡片上移，压住主视觉底部约 1/4（375rpx × 1/4 ≈ 94rpx） */
.preset-card {
  position: relative;
  z-index: 1;
  margin-top: -94rpx;
}

/* 页脚样式 */
.site-footer {
  margin-top: 60rpx;
  padding: 48rpx 24rpx 32rpx;
  border-top: 1rpx solid #E5E7EB;
  background: #F9FAFB;
  margin-left: -24rpx;
  margin-right: -24rpx;
  margin-bottom: -24rpx;
}

.footer-section {
  margin-bottom: 32rpx;
}

.footer-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
}

.footer-copyright {
  font-size: 22rpx;
  color: #9CA3AF;
  text-align: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #E5E7EB;
}

/* 预设按钮滚动条隐藏 */
.presets::-webkit-scrollbar {
  display: none;
}

.presets {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* 输入框placeholder颜色 */
.field-input::-webkit-input-placeholder {
  color: #D1D5DB;
}

/* 财务自由指数卡片 */
.index-card {
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
  margin-bottom: 28rpx;
}

.index-head {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.index-band {
  margin-left: auto;
  font-size: 22rpx;
  color: #9CA3AF;
}

.index-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.index-score-wrap {
  display: flex;
  align-items: baseline;
}

.index-score {
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -2rpx;
  font-variant-numeric: tabular-nums;
}

.index-score.green { color: #10B981; }
.index-score.yellow { color: #F59E0B; }
.index-score.orange { color: #F97316; }
.index-score.red { color: #EF4444; }

.index-score-unit {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-left: 8rpx;
}

.index-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.index-meta .level-badge {
  margin: 0;
}

.index-peer {
  font-size: 22rpx;
  color: #6B7280;
}

.index-dims {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.dim-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.dim-name {
  font-size: 23rpx;
  color: #6B7280;
}

.dim-score {
  font-size: 23rpx;
  color: #9CA3AF;
  font-variant-numeric: tabular-nums;
}

.dim-track {
  height: 12rpx;
  background: #F3F4F6;
  border-radius: 999rpx;
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  border-radius: 999rpx;
}

.dim-fill.green { background: #10B981; }
.dim-fill.yellow { background: #F59E0B; }
.dim-fill.orange { background: #F97316; }
.dim-fill.red { background: #EF4444; }

.insights {
  border-top: 1rpx solid #F3F4F6;
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.insight-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.insight-tag {
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.5;
}

.tag-good { background: #DCFCE7; color: #15803D; }
.tag-bad { background: #FEE2E2; color: #B91C1C; }
.tag-tip { background: #EEF2FF; color: #4F46E5; }

.insight-text {
  flex: 1;
  font-size: 23rpx;
  color: #4B5563;
  line-height: 1.6;
}

.index-note {
  margin-top: 24rpx;
  font-size: 21rpx;
  color: #9CA3AF;
  line-height: 1.6;
}
