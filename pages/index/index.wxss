/* pages/index/index.wxss */

/* 页脚样式 */
.site-footer {
  margin-top: 60rpx;
  padding: 48rpx 24rpx 32rpx;
  border-top: 1rpx solid #E5E7EB;
  background: #F9FAFB;
  margin-left: -24rpx;
  margin-right: -24rpx;
  margin-bottom: -24rpx;
}

.footer-section {
  margin-bottom: 32rpx;
}

.footer-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 12rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
}

.footer-copyright {
  font-size: 22rpx;
  color: #9CA3AF;
  text-align: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #E5E7EB;
}

/* 预设按钮滚动条隐藏 */
.presets::-webkit-scrollbar {
  display: none;
}

.presets {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* 输入框placeholder颜色 */
.field-input::-webkit-input-placeholder {
  color: #D1D5DB;
}
