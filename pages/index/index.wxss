/* pages/index/index.wxss */

/* ===== 顶部主视觉 ===== */

.page-hero {
  margin: -24rpx -24rpx 0;
  height: 375rpx;
  overflow: hidden;
  background: #0B1030;
}

.page-hero-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 首张卡片上移，压住主视觉底部约 1/4（375rpx × 1/4 ≈ 94rpx） */
.preset-card {
  position: relative;
  z-index: 1;
  margin-top: -94rpx;
}

/* ===== 财务自由指数 ===== */

.index-card {
  background: #FFFFFF;
  border: 1rpx solid #E4E8F0;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.index-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.index-band {
  margin-left: auto;
  font-size: 22rpx;
  color: #9CA3AF;
}

.index-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.index-score-wrap {
  display: flex;
  align-items: baseline;
}

.index-score {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.index-score.green { color: #10B981; }
.index-score.yellow { color: #F59E0B; }
.index-score.orange { color: #F97316; }
.index-score.red { color: #EF4444; }

.index-score-unit {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-left: 8rpx;
}

.index-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.index-meta .level-badge {
  margin-top: 0;
}

.index-peer {
  font-size: 22rpx;
  color: #6B7280;
}

.index-dims {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.dim-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.dim-name {
  font-size: 22rpx;
  color: #6B7280;
}

.dim-score {
  font-size: 22rpx;
  color: #9CA3AF;
  font-variant-numeric: tabular-nums;
}

.dim-track {
  height: 10rpx;
  background: #F3F4F6;
  border-radius: 999rpx;
  overflow: hidden;
}

.dim-fill {
  height: 100%;
  border-radius: 999rpx;
}

.dim-fill.green { background: #10B981; }
.dim-fill.yellow { background: #F59E0B; }
.dim-fill.orange { background: #F97316; }
.dim-fill.red { background: #EF4444; }

.insights {
  border-top: 1rpx solid #F3F4F6;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.insight-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.insight-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  line-height: 1.5;
}

.tag-good { background: #DCFCE7; color: #15803D; }
.tag-bad { background: #FEE2E2; color: #B91C1C; }
.tag-tip { background: #E9EDFA; color: #192E7E; }

.insight-text {
  flex: 1;
  font-size: 22rpx;
  color: #4B5563;
  line-height: 1.6;
}

.index-note {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.7;
}

/* ===== 页脚 ===== */

.site-footer {
  margin: 40rpx -24rpx -24rpx;
  padding: 32rpx 24rpx 24rpx;
  border-top: 1rpx solid #E5E7EB;
}

.footer-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 8rpx;
}

.footer-title .fa {
  font-size: 24rpx;
  color: #6B7280;
}

.footer-text {
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.7;
}

.footer-copyright {
  margin-top: 24rpx;
  font-size: 20rpx;
  color: #9CA3AF;
  text-align: center;
}

/* 预设横向滚动条隐藏 */
.presets::-webkit-scrollbar {
  display: none;
}

.presets {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* 输入框 placeholder */
.field-input::-webkit-input-placeholder {
  color: #C7CBD3;
}
