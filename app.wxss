/* app.wxss 全局样式
 *
 * 设计基准（750rpx 视口）
 * 间距：8 / 12 / 16 / 24 / 32 / 40
 * 圆角：12 控件 · 16 分组 · 24 卡片
 * 字号：20 注释 / 22 辅助 / 24 正文 / 26 小标题 / 28 段落标题 / 32 卡片标题 / 64 数值
 * 主色（取自主视觉 images/hero.jpg）：#0B143D 深底 / #192E7E 文字 / #2E449C 主色 / #556CC9 浅强调 / #E9EDFA 选中底
 * 文字：#111827 / #1F2937 / #4B5563 / #6B7280 / #9CA3AF
 */

page {
  background-color: #FBFBFB;
  color: #1F2937;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif;
  /* 点击态高亮跟随主题色，避免系统默认的蓝/灰闪一下 */
  -webkit-tap-highlight-color: rgba(46, 68, 156, 0.10);
}

/* 文字选中高亮：iOS 默认偏蓝、Android 默认偏青，统一成主题靛蓝 */
::selection {
  background: rgba(46, 68, 156, 0.22);
  color: #111827;
}

view, text, button, input {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
}

/* ===== 卡片 ===== */

.card {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 24rpx;
  border: 1rpx solid #ECEEF2;
}

.card-shadow {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 24, 39, 0.06);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.decorator {
  width: 6rpx;
  height: 28rpx;
  background-color: #2E449C;
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.card-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.card-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.card-value {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.card-value.green { color: #10B981; }
.card-value.yellow { color: #F59E0B; }
.card-value.red { color: #EF4444; }
.card-value.indigo { color: #2E449C; }
.card-value.gray { color: #6B7280; }

.card-sub {
  font-size: 24rpx;
  color: #4B5563;
  margin-top: 8rpx;
  line-height: 1.6;
}

/* ===== 等级徽章 ===== */

.level-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-top: 16rpx;
  line-height: 1.4;
}

.level-green { background: #DCFCE7; color: #15803D; }
.level-yellow { background: #FEF3C7; color: #B45309; }
.level-orange { background: #FFEDD5; color: #C2410C; }
.level-red { background: #FEE2E2; color: #B91C1C; }
.level-gray { background: #F3F4F6; color: #4B5563; }

/* ===== 表单 ===== */

.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 10rpx;
}

.field-input {
  width: 100%;
  height: 76rpx;
  caret-color: #2E449C;
  padding: 0 20rpx;
  border: 2rpx solid #E3E7ED;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #FFFFFF;
  color: #1F2937;
}

.field-input.is-focus {
  border-color: #2E449C;
}

/* 浅色面板上的输入框需要更实的描边，否则上边缘会看不清 */
.mode-panel .field-input {
  border-color: #CFD8EA;
}

/* 面板内的聚焦态需要更高特异性，否则会被上面的规则覆盖 */
.mode-panel .field-input.is-focus {
  border-color: #2E449C;
}

/* ===== 折叠分组 ===== */

.section {
  margin-bottom: 24rpx;
  border: 1rpx solid #F0F1F3;
  border-radius: 16rpx;
  background: #FFFFFF;
  overflow: hidden;
}

.section-header {
  font-size: 26rpx;
  font-weight: 600;
  padding: 22rpx 32rpx;
  color: #374151;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F9FAFB;
}

.section-header .arrow {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-left: 12rpx;
  transition: transform 0.2s;
}

.section.collapsed .arrow {
  transform: rotate(-90deg);
}

.section-body {
  padding: 24rpx 32rpx 32rpx;
}

.section.collapsed .section-body {
  display: none;
}

/* ===== 模式专属输入区 ===== */

.mode-panel {
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  background: #F0F4FC;
  border: 1rpx solid #D5DEF4;
  border-radius: 16rpx;
}

/* ===== 选项芯片（预设 / 对比收益率） ===== */

/* scroll-view 内部是独立的滚动容器，不能用 flex + gap 布局子项
   左右负边距让滚动区域贴到卡片边缘，芯片在边缘被裁切，滚动感更自然 */
.presets {
  margin: 0 -32rpx;
  padding: 0 32rpx;
  white-space: nowrap;
  font-size: 0;
  line-height: 0;
}

.preset-btn {
  display: inline-block;
  vertical-align: top;
  padding: 16rpx 24rpx;
  margin-right: 12rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
  line-height: 1.5;
  white-space: nowrap;
}

.preset-btn:last-child {
  margin-right: 0;
}

.preset-btn.active {
  border-color: #2E449C;
  background: #E9EDFA;
  color: #192E7E;
}

.preset-btn-hover {
  background: #F3F4F6;
}

.compare-rates {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.compare-rate-item {
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #374151;
  line-height: 1.5;
}

.compare-rate-item.checked {
  background: #E9EDFA;
  border-color: #2E449C;
  color: #192E7E;
  font-weight: 500;
}

.compare-rate-hover {
  background: #F3F4F6;
}

/* ===== 模式切换 ===== */

.mode-tabs {
  display: flex;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 4rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  min-width: 0;
  padding: 14rpx 8rpx;
  background: transparent;
  border-radius: 10rpx;
  text-align: center;
  color: #6B7280;
}

.mode-tab.active {
  background: #FFFFFF;
  color: #192E7E;
  box-shadow: 0 2rpx 6rpx rgba(17, 24, 39, 0.06);
}

.mode-tab-title {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
}

.mode-tab-sub {
  font-size: 20rpx;
  color: #9CA3AF;
  display: block;
  margin-top: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mode-tab.active .mode-tab-sub {
  color: #2E449C;
}

.mode-tab-hover {
  background: rgba(255, 255, 255, 0.6);
}

/* ===== 滑块 ===== */

.slider-block {
  margin-bottom: 24rpx;
}

.slider-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #2E449C;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  margin: 8rpx 0 12rpx;
}

/* ===== 图表 ===== */

.charts {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.chart-container {
  background: #FFFFFF;
  padding: 32rpx;
  border-radius: 24rpx;
  border: 1rpx solid #ECEEF2;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 20rpx;
}

.chart-canvas {
  width: 100%;
  height: 560rpx;
}

.chart-canvas.tall {
  height: 720rpx;
}

/* ===== 结果区 ===== */

.cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

/* 结果区标题卡：与结果卡同一种平面样式，仅补足下间距 */
.result-head {
  margin-bottom: 24rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin: 32rpx 0 24rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  color: #192E7E;
  border: 1rpx solid #C3CDEE;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* 去掉小程序 button 默认的 ::after 描边 */
.action-btn::after {
  border: none;
}

.action-btn-hover {
  background: #E9EDFA;
}

/* ===== 空状态 ===== */

.empty-state {
  padding: 56rpx 40rpx;
  text-align: center;
  background: #FFFFFF;
  border: 1rpx solid #F0F1F3;
  border-radius: 24rpx;
}

.empty-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.7;
}

/* ===== 自定义科目行 ===== */

.custom-row {
  display: flex;
  gap: 12rpx;
}

.custom-row .field {
  flex: 1;
  margin-bottom: 0;
}

.custom-row .field:first-child {
  flex: 1.2;
}
