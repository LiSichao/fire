  font-weight: 900;
  font-style: normal;
  font-display: block;
}

.fa {
  font-family: 'FA Solid';
  font-weight: 900;
  font-style: normal;
  line-height: 1;
  display: inline-block;
  -webkit-font-smoothing: antialiased;
}

